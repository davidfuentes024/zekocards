{
  "name": "zekocards",
  "version": "1.0.0",
  "description": "Learn hiragana, katakana and kanji by repetition. A static SvelteKit app with no account and no tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidfuentes024/zekocards.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "audio:build": "node scripts/audio/build.js",
    "audio:verify": "node scripts/audio/verify.js",
    "audio:pack": "node scripts/audio/pack.js",
    "audio": "npm run audio:build && npm run audio:pack"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
